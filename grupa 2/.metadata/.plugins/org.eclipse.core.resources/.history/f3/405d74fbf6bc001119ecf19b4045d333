package ro.ase.ie.paralel.laborator;

public class ContBancar {

	double sold;

	public ContBancar(double sold) {
		super();
		this.sold = sold;
	}
	
	public void extrage(double valoare) {
		System.out.println("Se incearca o extragere de " + valoare);
		if(valoare > this.sold) {
			System.out.println("Suma prea mare");
		} else {
			this.sold -= valoare;
			System.out.println("Sold disponibil: " + this.sold);
		}
	}
	
	public double getSold() {
		return this.sold;
	}
}
